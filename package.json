{
  "name": "com-trua-bot",
  "version": "1.0.0",
  "description": "Bot Zalo chốt cơm trưa cho nhóm công ty, chạy trên Cloudflare Workers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute com-trua --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute com-trua --local --file=schema.sql",
    "webhook": "node scripts/set-webhook.mjs",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
